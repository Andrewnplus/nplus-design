---
import Base from "@/layouts/Base.astro";
import ReadingProgress from "@nplus/shared/components/ReadingProgress.astro";
import SubscribeBand from "@nplus/shared/components/SubscribeBand.astro";
---

<Base title="Components">
  {/* ReadingProgress rendered once at top so visitors can scroll & see it work. */}
  <ReadingProgress />

  <section class="mx-auto max-w-6xl px-6 py-16">
    <p class="text-xs font-semibold tracking-[0.25em] text-brand-600 uppercase">Components</p>
    <h1
      class="font-display mt-4 text-4xl leading-tight font-semibold tracking-tight text-surface-800 md:text-5xl"
    >
      Same component, two themes.
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-surface-600">
      Every component below is the exact same Astro file from{" "}
      <code class="font-mono text-brand-600">@nplus/shared</code>. Each card just wraps it with a
      different theme class.
    </p>

    {/* ── ReadingProgress ─────────────────────────────────── */}
    <h2
      class="font-display mt-16 text-2xl font-semibold tracking-tight text-surface-800 md:text-3xl"
    >
      ReadingProgress
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-surface-500">
      A 3px fixed bar at the top of the viewport. Scroll this page and watch the indigo bar at the
      very top of the page advance — that's the host site's brand color. In production it picks up
      each consumer's own brand-500. Already active at the top of this page.
    </p>
    <p class="mt-4 max-w-2xl text-xs leading-relaxed text-surface-400">
      Uses CSS scroll-driven animation (Chrome 115+, Safari 18+) with a JS scroll-listener
      fallback. Respects <code class="font-mono">prefers-reduced-motion</code>.
    </p>

    {/* ── SubscribeBand · band variant ─────────────────────────── */}
    <h2
      class="font-display mt-20 text-2xl font-semibold tracking-tight text-surface-800 md:text-3xl"
    >
      SubscribeBand <span class="text-base font-normal text-surface-400">— variant="band"</span>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-surface-500">
      Full-width dark closing CTA. Each consumer wraps this once via a per-site component
      (<code class="font-mono">SubscribeSubstack</code>, <code class="font-mono">SubstackCTA</code>).
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div class="theme-nplus-page overflow-hidden rounded-lg border border-surface-200">
        <p
          class="border-b border-surface-200 bg-surface-50 px-5 py-2 text-xs font-semibold tracking-widest text-brand-600 uppercase"
        >
          nplus.page
        </p>
        <SubscribeBand
          href="https://nplus.substack.com/subscribe"
          eyebrow="Newsletter"
          heading="訂閱「恩加 Andrew」電子報"
          subhead="每週一封。寫關於成長、突破、跨界思考的事。"
          cta="前往 Substack 訂閱 →"
          fineprint="由 Substack 提供 · 隨時可取消"
        />
      </div>

      <div class="theme-nplus-faith overflow-hidden rounded-lg border border-surface-200">
        <p
          class="border-b border-surface-200 bg-surface-50 px-5 py-2 text-xs font-semibold tracking-widest text-brand-600 uppercase"
        >
          nplus.faith
        </p>
        <SubscribeBand
          href="https://outsidethewall.substack.com"
          eyebrow="Subscribe"
          heading="把這類寫作直接送到你的信箱"
          subhead="每週一封——新文章、Podcast 筆記、與這週讓我想最多的那個問題。"
          cta="Subscribe on Substack →"
          fineprint="Powered by Substack · 隨時可取消"
        />
      </div>
    </div>

    {/* ── SubscribeBand · inline variant ───────────────────────── */}
    <h2
      class="font-display mt-20 text-2xl font-semibold tracking-tight text-surface-800 md:text-3xl"
    >
      SubscribeBand <span class="text-base font-normal text-surface-400">— variant="inline"</span>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-surface-500">
      Bordered card sized for use inside article bodies (after the conclusion, before the comments).
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <div class="theme-nplus-page rounded-lg border border-surface-200 p-6">
        <p class="text-xs font-semibold tracking-widest text-brand-600 uppercase">nplus.page</p>
        <SubscribeBand
          href="https://nplus.substack.com/subscribe"
          variant="inline"
          eyebrow="Newsletter"
          heading="想看更多這樣的內容？"
          subhead="訂閱電子報，新文章直送你的信箱。"
          cta="訂閱"
        />
      </div>

      <div class="theme-nplus-faith rounded-lg border border-surface-200 p-6">
        <p class="text-xs font-semibold tracking-widest text-brand-600 uppercase">nplus.faith</p>
        <SubscribeBand
          href="https://outsidethewall.substack.com"
          variant="inline"
          eyebrow="Subscribe"
          heading="想看更多這樣的寫作？"
          subhead="訂閱電子報，新文章直送你的信箱。"
          cta="Subscribe"
        />
      </div>
    </div>

    {/* ── SubscribeBand · compact variant ──────────────────────── */}
    <h2
      class="font-display mt-20 text-2xl font-semibold tracking-tight text-surface-800 md:text-3xl"
    >
      SubscribeBand <span class="text-base font-normal text-surface-400">— variant="compact"</span>
    </h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-surface-500">
      Single pill button, for hero CTA rows.
    </p>

    <div class="mt-8 flex flex-wrap gap-6">
      <div class="theme-nplus-page rounded-lg border border-surface-200 bg-surface-50 p-6">
        <p class="mb-4 text-xs font-semibold tracking-widest text-brand-600 uppercase">
          nplus.page
        </p>
        <SubscribeBand
          href="https://nplus.substack.com/subscribe"
          variant="compact"
          cta="訂閱電子報"
        />
      </div>

      <div class="theme-nplus-faith rounded-lg border border-surface-200 bg-surface-50 p-6">
        <p class="mb-4 text-xs font-semibold tracking-widest text-brand-600 uppercase">
          nplus.faith
        </p>
        <SubscribeBand
          href="https://outsidethewall.substack.com"
          variant="compact"
          cta="Subscribe"
        />
      </div>
    </div>
  </section>
</Base>
