---
interface Props {
  name: string;
  cssVar: string;
}

const { name, cssVar } = Astro.props;
---

<div class="flex items-center gap-3">
  <div
    class="h-10 w-10 flex-shrink-0 rounded-md border border-surface-200"
    style={`background: var(${cssVar});`}
  >
  </div>
  <div class="min-w-0">
    <p class="font-mono text-xs leading-tight text-surface-700">{name}</p>
    <p class="font-mono text-[10px] leading-tight text-surface-400">{cssVar}</p>
  </div>
</div>
